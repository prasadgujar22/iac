# -*- coding: utf-8 -*-
# =============================================================================
# configure_jms.py - WLST online script to configure JMS module
# Generated by Ansible for JMS HA POC
# =============================================================================

import sys

def absent(mbean_path):
    """Return True when the MBean does not yet exist (pending or activated)."""
    return getMBean(mbean_path) is None

print("=== Connecting to Admin Server ===")
connect('{{ wls_admin_user }}', '{{ wls_admin_password }}',
        't3://{{ admin_server_host }}:{{ admin_server_port }}')

edit()

# ---- Release any stale edit session -----------------------------------------
# cancelEdit('y') can itself raise BeanRemoveRejectedException when a pending
# SubDeployment still references a pending JMSServer – WebLogic validates
# referential integrity even during rollback and fails if it tries to remove
# the JMSServer before the SubDeployment target is cleared.
#
# Resolution (three tries, each more invasive):
#   1. Plain cancelEdit – works when there is no stale session.
#   2. Join the stale session, clear all SubDeployment targets (breaks the
#      cross-reference), then retry cancelEdit.
#   3. If cancel still fails, continue in the dirty session; the plain-Queue
#      cleanup below and getMBean guards prevent save() from failing again.

_cancelled = False

try:
    cancelEdit('y')
    _cancelled = True
except WLSTException:
    pass

if not _cancelled:
    try:
        startEdit()   # join the stale session so we can modify it
        _jms_mod = getMBean('/JMSSystemResources/{{ jms_module_name }}')
        if _jms_mod is not None:
            for _sd in _jms_mod.getSubDeployments():
                _sd.setTargets(jarray.array([], ObjectName))
        cancelEdit('y')
        _cancelled = True
    except WLSTException:
        pass   # fall through – dirty session, handled below

startEdit()

# ---- Remove any plain Queue left by an earlier failed run -------------------
# A plain Queue cannot belong to a SubDeployment targeting multiple JMSServers;
# save() will reject it with JMSExceptions:045047.  Delete it here so it can
# be recreated below as a UniformDistributedQueue.
_old_queue_path = ('/JMSSystemResources/{{ jms_module_name }}'
                   '/JMSResource/{{ jms_module_name }}'
                   '/Queues/{{ jms_queue_name }}')
if getMBean(_old_queue_path) is not None:
    print("Removing stale plain Queue '{{ jms_queue_name }}' – will recreate as UDQ")
    cd('/JMSSystemResources/{{ jms_module_name }}/JMSResource/{{ jms_module_name }}')
    delete('{{ jms_queue_name }}', 'Queue')

# ---- JMS Server (one per managed server) ------------------------------------
{% for ms in managed_servers %}
if absent('/JMSServers/JMSServer-{{ ms.name }}'):
    print("Creating JMS Server for {{ ms.name }}")
    cd('/')
    create('JMSServer-{{ ms.name }}', 'JMSServer')
else:
    print("JMS Server JMSServer-{{ ms.name }} already exists, skipping")
cd('/JMSServers/JMSServer-{{ ms.name }}')
set('Targets', jarray.array([ObjectName('com.bea:Name={{ ms.name }},Type=Server')], ObjectName))
{% endfor %}

# ---- JMS Module -------------------------------------------------------------
if absent('/JMSSystemResources/{{ jms_module_name }}'):
    print("Creating JMS Module: {{ jms_module_name }}")
    cd('/')
    create('{{ jms_module_name }}', 'JMSSystemResource')
else:
    print("JMS Module {{ jms_module_name }} already exists, skipping")
cd('/JMSSystemResources/{{ jms_module_name }}')
set('Targets', jarray.array([ObjectName('com.bea:Name={{ cluster_name }},Type=Cluster')], ObjectName))

# ---- SubDeployment for Connection Factory (targets Cluster) -----------------
# A CF must be available on every cluster member, so it targets the Cluster.
if absent('/JMSSystemResources/{{ jms_module_name }}/SubDeployments/{{ jms_subdeployment_name }}-CF'):
    print("Creating SubDeployment {{ jms_subdeployment_name }}-CF")
    cd('/JMSSystemResources/{{ jms_module_name }}')
    create('{{ jms_subdeployment_name }}-CF', 'SubDeployment')
cd('/JMSSystemResources/{{ jms_module_name }}/SubDeployments/{{ jms_subdeployment_name }}-CF')
set('Targets', jarray.array([ObjectName('com.bea:Name={{ cluster_name }},Type=Cluster')], ObjectName))

# ---- SubDeployment for Uniform Distributed Queue (targets all JMS Servers) --
# A UniformDistributedQueue subdeployment may target multiple JMS Servers;
# plain Queue/Topic subdeployments may not.
if absent('/JMSSystemResources/{{ jms_module_name }}/SubDeployments/{{ jms_subdeployment_name }}'):
    print("Creating SubDeployment {{ jms_subdeployment_name }}")
    cd('/JMSSystemResources/{{ jms_module_name }}')
    create('{{ jms_subdeployment_name }}', 'SubDeployment')
cd('/JMSSystemResources/{{ jms_module_name }}/SubDeployments/{{ jms_subdeployment_name }}')
set('Targets', jarray.array([
{% for ms in managed_servers %}
    ObjectName('com.bea:Name=JMSServer-{{ ms.name }},Type=JMSServer'),
{% endfor %}
], ObjectName))

# ---- Connection Factory -----------------------------------------------------
_cf_name = '{{ jms_connection_factory_jndi | replace("/", "_") }}'
_cf_path  = ('/JMSSystemResources/{{ jms_module_name }}'
             '/JMSResource/{{ jms_module_name }}'
             '/ConnectionFactories/' + _cf_name)
if absent(_cf_path):
    print("Creating Connection Factory")
    cd('/JMSSystemResources/{{ jms_module_name }}/JMSResource/{{ jms_module_name }}')
    create(_cf_name, 'ConnectionFactory')
cd(_cf_path)
set('JNDIName', '{{ jms_connection_factory_jndi }}')
set('SubDeploymentName', '{{ jms_subdeployment_name }}-CF')

# ---- Uniform Distributed Queue ----------------------------------------------
# UDQ spans all targeted JMS Servers so the queue is HA across the cluster.
_udq_path = ('/JMSSystemResources/{{ jms_module_name }}'
             '/JMSResource/{{ jms_module_name }}'
             '/UniformDistributedQueues/{{ jms_queue_name }}')
if absent(_udq_path):
    print("Creating Uniform Distributed Queue: {{ jms_queue_name }}")
    cd('/JMSSystemResources/{{ jms_module_name }}/JMSResource/{{ jms_module_name }}')
    create('{{ jms_queue_name }}', 'UniformDistributedQueue')
cd(_udq_path)
set('JNDIName', '{{ jms_queue_jndi }}')
set('SubDeploymentName', '{{ jms_subdeployment_name }}')

# ---- Activate ---------------------------------------------------------------
save()
activate(block='true')

print("JMS Configuration Complete")
disconnect()
exit()
