#!/bin/bash
# =============================================================================
# startManagedServer.sh  –  Ansible-generated wrapper
# Deployed to: {{ domain_home }}/bin/startManagedServer.sh
#
# Purpose: set env vars and delegate to the WLS-native
#   startManagedWebLogic.sh that unpack.sh created in the same bin/ directory.
#
# The server name ({{ ms_name }}) is rendered by Ansible from the
# managed_servers variable list so it always matches the WLS domain config,
# not the OS hostname.
# =============================================================================

export JAVA_HOME={{ jdk_home }}
export MW_HOME={{ mw_home }}
export DOMAIN_HOME={{ domain_home }}

# Credentials – WLS reads WLS_USER / WLS_PW when boot.properties is present
# and unencrypted.  After first boot WLS encrypts boot.properties in-place
# and these env vars become a harmless no-op.
export WLS_USER={{ wls_admin_user }}
export WLS_PW={{ wls_admin_password }}

SERVER_NAME={{ ms_name }}

exec "$DOMAIN_HOME/bin/startManagedWebLogic.sh" \
    "$SERVER_NAME" \
    "t3://{{ admin_server_host }}:{{ admin_server_port }}"
