#!/bin/bash
# =============================================================================
# Start WebLogic Managed Server
# Generated by Ansible
# =============================================================================

export JAVA_HOME={{ jdk_home }}
export MW_HOME={{ mw_home }}
export DOMAIN_HOME={{ domain_home }}
export WLS_USER={{ wls_admin_user }}
export WLS_PW={{ wls_admin_password }}

# Determine server name from hostname
SERVER_NAME=$(hostname -s)

cd "$DOMAIN_HOME"
exec "$DOMAIN_HOME/bin/startManagedWebLogic.sh" \
    "$SERVER_NAME" \
    "t3://{{ admin_server_host }}:{{ admin_server_port }}"
