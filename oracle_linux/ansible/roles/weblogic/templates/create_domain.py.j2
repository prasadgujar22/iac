# -*- coding: utf-8 -*-
# =============================================================================
# create_domain.py - WLST offline script to create the JMS HA domain
# Generated by Ansible for JMS HA POC
# =============================================================================

import os

print("=== Creating WebLogic Domain: {{ domain_name }} ===")

# ---- Select domain template ------------------------------------------------
readTemplate("{{ wls_home }}/common/templates/wls/wls.jar")

# ---- Domain-level settings -------------------------------------------------
cd('/')
set('Name', '{{ domain_name }}')

# ---- Admin server ----------------------------------------------------------
cd('/Server/AdminServer')
set('Name', '{{ admin_server_name }}')
set('ListenAddress', '{{ admin_server_host }}')
set('ListenPort', {{ admin_server_port }})

# In WLST offline mode the SSL bean is not pre-created by the template;
# create it explicitly before configuring it.
cd('/')
cd('/Server/{{ admin_server_name }}')
create('{{ admin_server_name }}', 'SSL')
cd('/Server/{{ admin_server_name }}/SSL/{{ admin_server_name }}')
set('Enabled', True)
set('ListenPort', {{ admin_server_ssl_port }})
cd('/')

# ---- Admin credentials -----------------------------------------------------
cd('/Security/{{ domain_name }}/User/weblogic')
cmo.setName('{{ wls_admin_user }}')
cmo.setPassword('{{ wls_admin_password }}')

# ---- Cluster ---------------------------------------------------------------
cd('/')
create('{{ cluster_name }}', 'Cluster')
cd('/Cluster/{{ cluster_name }}')
set('ClusterMessagingMode', 'unicast')

# ---- Managed servers -------------------------------------------------------
{% for ms in managed_servers %}
cd('/')
create('{{ ms.name }}', 'Server')
cd('/Server/{{ ms.name }}')
set('Cluster', '{{ cluster_name }}')
set('ListenAddress', '{{ ms.host }}')
set('ListenPort', {{ managed_server_port }})

create('{{ ms.name }}', 'SSL')
cd('/Server/{{ ms.name }}/SSL/{{ ms.name }}')
set('Enabled', True)
set('ListenPort', {{ managed_server_ssl_port }})
cd('/')

{% endfor %}

# ---- Machine entries (for Node Manager) ------------------------------------
{% for ms in managed_servers %}
cd('/')
create('machine-{{ ms.name }}', 'UnixMachine')
cd('/UnixMachine/machine-{{ ms.name }}')
set('PostBindUID', 'oracle')
create('nm-{{ ms.name }}', 'NodeManager')
cd('/UnixMachine/machine-{{ ms.name }}/NodeManager/nm-{{ ms.name }}')
set('ListenAddress', '{{ ms.host }}')
set('ListenPort', 5556)
set('NMType', 'Plain')

cd('/Server/{{ ms.name }}')
set('Machine', 'machine-{{ ms.name }}')
{% endfor %}

# Machine for Admin Server
cd('/')
create('machine-admin', 'UnixMachine')
cd('/UnixMachine/machine-admin')
set('PostBindUID', 'oracle')
create('nm-admin', 'NodeManager')
cd('/UnixMachine/machine-admin/NodeManager/nm-admin')
set('ListenAddress', '{{ admin_server_host }}')
set('ListenPort', 5556)
set('NMType', 'Plain')

cd('/Server/{{ admin_server_name }}')
set('Machine', 'machine-admin')

# ---- Finalize domain -------------------------------------------------------
setOption('ServerStartMode', 'prod')
setOption('OverwriteDomain', 'true')
writeDomain('{{ domain_home }}')
closeTemplate()

print("Domain Created Successfully: {{ domain_home }}")
exit()
