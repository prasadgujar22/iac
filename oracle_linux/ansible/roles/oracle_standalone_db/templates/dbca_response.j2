####################################################################
## Oracle DBCA – Silent Standalone Database Creation Response File
## Generated by Ansible for JMS HA POC
####################################################################

responseFileVersion=/oracle/assistants/dbca/rspfmt_dbca_response_schema_v19.0.0

#--------------------------------------------------------------------
# General
#--------------------------------------------------------------------
gdbName={{ oracle_db_name }}.lab.local
sid={{ oracle_db_name }}
databaseConfigType=SI

#--------------------------------------------------------------------
# Storage (filesystem – no ASM for standalone POC)
#--------------------------------------------------------------------
storageType=FS
datafileDestination={{ oracle_data_dir }}
recoveryAreaDestination={{ oracle_fra_dir }}
recoveryAreaSize={{ oracle_fra_size_mb }}

#--------------------------------------------------------------------
# Database type & template
#--------------------------------------------------------------------
templateName=General_Purpose.dbc
characterSet={{ oracle_db_char_set }}
nationalCharacterSet={{ oracle_db_nchar_set }}
createAsContainerDatabase=true
numberOfPDBs=1
pdbName={{ oracle_pdb_name }}
pdbAdminPassword={{ oracle_sys_password }}

#--------------------------------------------------------------------
# Memory (manual SGA+PGA – automaticMemoryManagement requires /dev/shm)
#--------------------------------------------------------------------
automaticMemoryManagement=false
totalMemory={{ oracle_memory_target_mb }}

#--------------------------------------------------------------------
# Listener registration port (listener must be running before DBCA)
#--------------------------------------------------------------------
listenerPort={{ listener_port }}

#--------------------------------------------------------------------
# Credentials
#--------------------------------------------------------------------
sysPassword={{ oracle_sys_password }}
systemPassword={{ oracle_system_password }}
dbsnmpPassword={{ oracle_dbsnmp_password }}

#--------------------------------------------------------------------
# Options
#--------------------------------------------------------------------
enableArchive=false
runCVUChecks=false
omsPort=0
dvConfiguration=false
olsConfiguration=false
