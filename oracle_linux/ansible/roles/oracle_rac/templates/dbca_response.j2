####################################################################
## Oracle DBCA – Silent RAC Database Creation Response File
## Generated by Ansible for JMS HA POC
####################################################################

responseFileVersion=/oracle/assistants/dbca/rspfmt_dbca_response_schema_v19.0.0

#--------------------------------------------------------------------
# General
#--------------------------------------------------------------------
gdbName={{ oracle_db_name }}.lab.local
sid={{ oracle_db_name }}
databaseConfigType=RAC
RACNodeList={{ oracle_node1_hostname }},{{ oracle_node2_hostname }}

policyManaged=false
# Instance naming: RACDB1, RACDB2
createServerPool=false

#--------------------------------------------------------------------
# Storage
#--------------------------------------------------------------------
storageType=ASM
diskGroupName={{ asm_data_diskgroup }}
recoveryGroupName={{ asm_fra_diskgroup }}

#--------------------------------------------------------------------
# Database type & template
#--------------------------------------------------------------------
templateName=General_Purpose.dbc
characterSet={{ oracle_db_char_set }}
nationalCharacterSet={{ oracle_db_nchar_set }}
createAsContainerDatabase=true
numberOfPDBs=1
pdbName={{ oracle_pdb_name }}
pdbAdminPassword={{ oracle_sys_password }}

#--------------------------------------------------------------------
# Memory
#--------------------------------------------------------------------
automaticMemoryManagement=false
totalMemory={{ oracle_memory_target_mb }}

#--------------------------------------------------------------------
# Credentials
#--------------------------------------------------------------------
sysPassword={{ oracle_sys_password }}
systemPassword={{ oracle_system_password }}
datafileDestination=+{{ asm_data_diskgroup }}
recoveryAreaDestination=+{{ asm_fra_diskgroup }}
recoveryAreaSize=20480

#--------------------------------------------------------------------
# Options
#--------------------------------------------------------------------
enableArchive=false
runCVUChecks=false
omsPort=0
dvConfiguration=false
olsConfiguration=false
