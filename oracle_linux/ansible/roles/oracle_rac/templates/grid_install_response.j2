####################################################################
## Oracle Grid Infrastructure 19c – Silent Install Response File
## Generated by Ansible for JMS HA POC
####################################################################

oracle.install.responseFileVersion=/oracle/install/rspfmt_crsinstall_response_schema_v19.0.0

#--------------------------------------------------------------------
# Installation Option
# INSTALL_DB_SWONLY  - Install only (no DB creation)
# UPGRADE            - Upgrade existing GI
#--------------------------------------------------------------------
oracle.install.option=CRS_CONFIG

#--------------------------------------------------------------------
# Cluster Configuration
#--------------------------------------------------------------------
ORACLE_BASE={{ grid_base }}
oracle.install.asm.OSDBA=asmdba
oracle.install.asm.OSOPER=asmoper
oracle.install.asm.OSASM=asmadmin

oracle.install.crs.config.gpnp.scanName={{ scan_name }}
oracle.install.crs.config.gpnp.scanPort={{ scan_port }}

oracle.install.crs.config.ClusterConfiguration=STANDALONE
oracle.install.crs.config.configureAsExtendedCluster=false
oracle.install.crs.config.clusterName={{ cluster_name }}
oracle.install.crs.config.clusterNodes={{ oracle_node1_hostname }}:{{ oracle_node1_hostname }}-vip,{{ oracle_node2_hostname }}:{{ oracle_node2_hostname }}-vip
oracle.install.crs.config.networkInterfaceList=eth0:192.168.29.0:1,eth1:10.0.0.0:5

# LOCAL_ASM_STORAGE: each cluster node runs its own ASM instance against
# shared block devices.  FLEX_ASM_STORAGE is for hub/leaf topology only;
# using it with a STANDALONE cluster causes [INS-30508] at the
# CreateASMDiskGroup validation step (fails in <20 ms, no disk I/O attempted).
oracle.install.crs.config.storageOption=LOCAL_ASM_STORAGE
oracle.install.crs.config.useIPMI=false

#--------------------------------------------------------------------
# ASM Configuration
#--------------------------------------------------------------------
oracle.install.asm.SYSASMPassword={{ oracle_asmsnmp_password }}
oracle.install.asm.monitorPassword={{ oracle_asmsnmp_password }}
oracle.install.asm.diskGroup.name={{ asm_data_diskgroup }}
oracle.install.asm.diskGroup.redundancy={{ asm_redundancy }}
oracle.install.asm.diskGroup.AUSize=4
oracle.install.asm.diskGroup.disksWithFailureGroupNames=
oracle.install.asm.diskGroup.disks={{ asm_data_partition }}
# Use * wildcard only – Oracle's discovery parser does not support POSIX
# bracket expressions ([b-z]); an unrecognised pattern returns no candidates,
# which also causes [INS-30508] before any disk I/O is attempted.
oracle.install.asm.diskGroup.diskDiscoveryString=/dev/sd*1

oracle.install.crs.rootconfig.executeRootScript=false

#--------------------------------------------------------------------
# GI Home info
#--------------------------------------------------------------------
ORACLE_HOME={{ grid_home }}
INVENTORY_LOCATION={{ oracle_inventory }}
oracle.install.crs.config.ignoreDownNodes=false
