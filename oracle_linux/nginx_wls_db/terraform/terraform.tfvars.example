# =============================================================================
# terraform.tfvars.example
# Copy to terraform.tfvars and fill in real values before running.
# DO NOT commit terraform.tfvars – it contains secrets.
# =============================================================================

proxmox_api_url          = "https://192.168.29.10:8006/api2/json"
proxmox_api_token_id     = "terraform@pve!terraform-token"
proxmox_api_token_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

target_node   = "praslab"
template_name = "oraclelinux-9-gold-template"
storage       = "local-lvm"

# Optionally override VM sizing
# nginx_cpu_cores     = 2
# nginx_memory_mb     = 2048
# wls_admin_cpu_cores = 4
# wls_admin_memory_mb = 8192
# wls_node_cpu_cores  = 4
# wls_node_memory_mb  = 8192
# oracle_db_cpu_cores = 4
# oracle_db_memory_mb = 16384
