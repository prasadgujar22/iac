# -*- coding: utf-8 -*-
# =============================================================================
# WLST offline script - Create WebLogic domain with 2-node cluster
# Generated by Ansible - do NOT edit manually
# =============================================================================

readTemplate('{{ wls_home }}/common/templates/wls/wls.jar')

# --- Domain settings ---
set('Name', '{{ domain_name }}')
setOption('DomainName', '{{ domain_name }}')
setOption('JavaHome', '{{ jdk_home }}')
setOption('ServerStartMode', 'prod')

# --- Admin Server credentials ---
cd('/Security/{{ domain_name }}/User/weblogic')
cmo.setName('{{ wls_admin_user }}')
cmo.setPassword('{{ wls_admin_password }}')

# --- Admin Server listen address & port ---
cd('/Server/AdminServer')
set('ListenAddress', '{{ admin_server_host }}')
set('ListenPort', {{ admin_server_port }})
set('Name', '{{ admin_server_name }}')

# --- Create cluster ---
create('{{ cluster_name }}', 'Cluster')
cd('/Cluster/{{ cluster_name }}')
set('ClusterMessagingMode', 'unicast')

# --- Create Managed Servers ---
{% for ms in managed_servers %}
create('{{ ms.name }}', 'Server')
cd('/Server/{{ ms.name }}')
set('ListenAddress', '{{ ms.host }}')
set('ListenPort', {{ managed_server_port }})
set('Cluster', '{{ cluster_name }}')
{% endfor %}

# --- Node Manager configuration ---
cd('/NMProperties')
set('JavaHome', '{{ jdk_home }}')
set('ListenAddress', '')
set('ListenPort', {{ node_manager_port }})
set('NMType', '{{ node_manager_type }}')
set('StartScriptEnabled', 'true')
set('StartScriptName', 'startWebLogic.sh')

{% if wls_ds_name is defined %}
# --- JDBC DataSource for Oracle DB ---
create('{{ wls_ds_name }}', 'JDBCSystemResource')
cd('/JDBCSystemResource/{{ wls_ds_name }}/JdbcResource/{{ wls_ds_name }}')
set('Name', '{{ wls_ds_name }}')
create('{{ wls_ds_name }}Params', 'JDBCDataSourceParams')
cd('JDBCDataSourceParams/{{ wls_ds_name }}Params')
set('JNDIName', java.lang.String('{{ wls_ds_jndi }}'))

cd('/JDBCSystemResource/{{ wls_ds_name }}/JdbcResource/{{ wls_ds_name }}')
create('{{ wls_ds_name }}DriverParams', 'JDBCDriverParams')
cd('JDBCDriverParams/{{ wls_ds_name }}DriverParams')
set('DriverName', '{{ wls_ds_driver }}')
set('URL', '{{ wls_ds_url }}')
set('PasswordEncrypted', '{{ wls_ds_password }}')

create('{{ wls_ds_name }}Properties', 'Properties')
cd('Properties/{{ wls_ds_name }}Properties')
create('user', 'Property')
cd('Property/user')
set('Value', '{{ wls_ds_user }}')

cd('/JDBCSystemResource/{{ wls_ds_name }}/JdbcResource/{{ wls_ds_name }}')
create('{{ wls_ds_name }}ConnectionPoolParams', 'JDBCConnectionPoolParams')
cd('JDBCConnectionPoolParams/{{ wls_ds_name }}ConnectionPoolParams')
set('MaxCapacity', {{ wls_ds_max_capacity }})
set('InitialCapacity', {{ wls_ds_initial_capacity }})
set('TestConnectionsOnReserve', 'true')
set('TestTableName', 'SQL SELECT 1 FROM DUAL')

# --- Target DS to cluster ---
cd('/JDBCSystemResource/{{ wls_ds_name }}')
set('Target', '{{ cluster_name }}')
{% endif %}

# --- Write domain ---
writeDomain('{{ domain_home }}')
closeTemplate()

print('Domain created successfully: {{ domain_name }}')
exit()
