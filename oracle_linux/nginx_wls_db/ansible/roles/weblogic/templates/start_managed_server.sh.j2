#!/bin/bash
# Start Managed Server {{ inventory_hostname_short }}
# Generated by Ansible – do NOT edit manually

export JAVA_HOME={{ jdk_home }}
export MW_HOME={{ mw_home }}
export DOMAIN_HOME={{ domain_home }}
export ADMIN_URL={{ admin_server_url }}
export SERVER_NAME={{ inventory_hostname_short }}

# WLS requires username/password to connect to Admin Server at start
export WLS_USER={{ wls_admin_user }}
export WLS_PW={{ wls_admin_password }}

{{ domain_home }}/bin/startManagedWebLogic.sh \
  {{ inventory_hostname_short }} \
  ${ADMIN_URL}
