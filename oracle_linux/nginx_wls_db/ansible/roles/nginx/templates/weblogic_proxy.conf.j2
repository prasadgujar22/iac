# =============================================================================
# Nginx reverse-proxy / load balancer for Oracle WebLogic cluster
# Generated by Ansible – do NOT edit manually
# =============================================================================

# ---------------------------------------------------------------------------
# Upstream: WebLogic Managed Servers (round-robin by default)
# ---------------------------------------------------------------------------
upstream {{ nginx_upstream_name }} {
{% for srv in nginx_upstream_servers %}
    server {{ srv.host }}:{{ srv.port }};
{% endfor %}

    # Keep alive connections to WLS
    keepalive 32;
}

# ---------------------------------------------------------------------------
# HTTP virtual host
# ---------------------------------------------------------------------------
server {
    listen      {{ nginx_listen_port }};
    server_name {{ nginx_server_name }};

    access_log  {{ nginx_access_log }};
    error_log   {{ nginx_error_log }};

    # ------------------------------------------------------------------
    # Health-check endpoint (returns 200 without hitting WLS)
    # ------------------------------------------------------------------
    location = {{ nginx_health_check_path }} {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # ------------------------------------------------------------------
    # Proxy all traffic to the WebLogic cluster
    # ------------------------------------------------------------------
    location {{ nginx_proxy_context }} {
        proxy_pass         http://{{ nginx_upstream_name }};
        proxy_http_version 1.1;

        # Required for WebLogic session stickiness via WL-Proxy-SSL header
        proxy_set_header   Connection        "";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # WebLogic-specific proxy headers
        proxy_set_header   WL-Proxy-Client-IP  $remote_addr;

        # Timeouts – WLS can be slow to respond under heavy load
        proxy_connect_timeout  10s;
        proxy_send_timeout     60s;
        proxy_read_timeout    120s;

        # Buffer settings
        proxy_buffering    on;
        proxy_buffer_size  16k;
        proxy_buffers      4 64k;
    }
}
