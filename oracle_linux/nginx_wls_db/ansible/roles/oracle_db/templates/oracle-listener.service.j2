[Unit]
Description=Oracle Net Listener
After=network.target

[Service]
Type=forking
User={{ oracle_user }}
Environment=ORACLE_HOME={{ oracle_home }}
Environment=PATH={{ oracle_home }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart={{ oracle_home }}/bin/lsnrctl start {{ listener_name }}
ExecStop={{ oracle_home }}/bin/lsnrctl stop {{ listener_name }}
TimeoutStartSec=120
TimeoutStopSec=60
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
